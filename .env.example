# Aster & Row AI Support Agent Configuration

# LLM Provider Configuration
# Set OPENAI_API_KEY for live LLM mode. If not set, agent runs in deterministic offline mock mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# Agent runtime settings
DEBUG_MODE=false
CONFIDENCE_THRESHOLD=0.75
MAX_RETRIEVED_CHUNKS=4
