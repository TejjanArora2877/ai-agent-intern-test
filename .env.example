# Aster & Row AI Support Agent Configuration

# Gemini Live LLM Provider Configuration
# Set GEMINI_API_KEY from Google AI Studio for live LLM mode.
# If omitted, agent runs automatically in deterministic offline mock mode.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

# Agent runtime settings
DEBUG_MODE=false
MAX_RETRIEVED_CHUNKS=6
